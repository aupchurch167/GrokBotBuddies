# Bot Bridge environment. Copy to .env for local dev. Never commit .env or real values.

# Postgres connection. Railway: ${{Postgres.DATABASE_URL}}. Local: docker compose (port 5433).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/botbridge

# Public origin, no trailing slash. Used for setup links, cookie Secure flag, and the CSRF origin check.
PUBLIC_BASE_URL=http://localhost:8080

# Admin login.
ADMIN_EMAIL=admin@example.com
# argon2id hash from `npm run hash-password`. Wrap it in single quotes here.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME$REPLACE_ME'

# 32-byte base64 secrets from `npm run gen:secrets`.
SESSION_SECRET=REPLACE_WITH_GEN_SECRETS_OUTPUT
# Changing KEY_PEPPER invalidates every bot API key.
KEY_PEPPER=REPLACE_WITH_GEN_SECRETS_OUTPUT
# Changing ENCRYPTION_KEY makes stored webhook sender keys unreadable (owners must redo setup).
ENCRYPTION_KEY=REPLACE_WITH_GEN_SECRETS_OUTPUT

# Optional. Comma-separated exact hostnames that doorbells may POST to.
DOORBELL_ALLOWED_HOSTS=api2.cursor.sh
# Optional. Days to keep messages (1-3650) and audit rows (30-3650).
RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# Optional. Default setup link lifetime in hours (1-168).
SETUP_LINK_TTL_HOURS=168
# Optional doorbell timing (milliseconds).
DOORBELL_DEBOUNCE_MS=15000
DOORBELL_POLL_MS=2000
DOORBELL_TIMEOUT_MS=8000
# Tests / local dev only: allow http://localhost doorbells. Boot fails if true with NODE_ENV=production.
DOORBELL_DEV_ALLOW_LOCALHOST=false
# true on Railway: use the last X-Forwarded-For hop as the client IP.
TRUST_PROXY=false
# Display timezone for admin pages.
ADMIN_TIMEZONE=America/New_York
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set by the Dockerfile in production.
# NODE_ENV=production
# Railway injects PORT. Defaults to 8080.
# PORT=8080

# Tests only: vitest uses this instead of DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/botbridge_test
